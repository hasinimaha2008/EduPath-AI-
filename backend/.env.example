# ==============================================================================
# EDUPATH AI BACKEND — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this template to 'backend/.env' for local backend development.
# ==============================================================================

# Application Environment (development | testing | production)
ENVIRONMENT=development
PORT=8000

# Security: JWT Secret Key (Mandatory >= 32 characters in production)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev_insecure_secret_replace_in_production_32chars

# Demo Login Flag (Defaults to false in production, true in development)
ALLOW_DEMO_LOGIN=true

# Database Connection URL
# SQLite Async (Default for local development):
DATABASE_URL=sqlite+aiosqlite:///edupath.db
# PostgreSQL Async (Production Supabase / Neon / Render):
# DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/dbname

# Google Gemini API Key (Required for AI Study Assistant & Quiz Generation)
GEMINI_API_KEY=

# Distributed Redis Connection URL (Optional, fallback to in-memory sliding window)
REDIS_URL=

# Rate Limiting
AUTH_RATE_LIMIT_PER_MINUTE=30
AI_RATE_LIMIT_PER_MINUTE=20

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Document Uploads Directory
UPLOAD_DIR=./uploads
